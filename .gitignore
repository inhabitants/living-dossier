# Living Dossier: this repository holds the METHOD, never health data.
# The main protection is keeping your dossier folder OUTSIDE any git repository.
# The rules below are the second layer, so nobody pushes lab results or DNA to a fork by accident.

# Lab results, reports and photos
*.pdf
*.jpg
*.jpeg
*.png
*.heic
*.heif
*.webp
*.tif
*.tiff
*.dcm

# Spreadsheets and exports (DNA chips usually come as .txt/.csv)
*.csv
*.tsv
*.txt
*.xlsx
*.xls

# Genetic files
*.vcf
*.vcf.gz
*.tbi
*.csi
*.cram
*.crai
*.bam
*.bai
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bcf
*.somalier

# Typical personal dossier folders
Exams/
exams/
Exames/
exames/
new/
novos/
DNA/
dna/
my-dossier/
meu-dossie/
Health/
health/
Saude/
saude/

# System
.DS_Store
Thumbs.db

# The one-skill package that pack/pack.mjs builds
living-dossier.zip

# The project's own files that the rules above would catch
!llms.txt
!site/
!site/**
